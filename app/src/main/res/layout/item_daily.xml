<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="110dp" android:layout_height="wrap_content"
    android:layout_marginEnd="16dp" android:background="@drawable/glass_daily_selector"
    android:focusable="true" android:focusableInTouchMode="true"
    android:gravity="center" android:orientation="vertical"
    android:paddingTop="20dp" android:paddingBottom="20dp">
    <TextView android:id="@+id/day_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon" android:textColor="#B3FFFFFF" android:textSize="16sp" android:fontFamily="sans-serif-medium"/>
    <TextView android:id="@+id/day_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="☁️" android:textSize="28sp"/>
    <TextView android:id="@+id/day_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="20°" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium"/>
</LinearLayout>
