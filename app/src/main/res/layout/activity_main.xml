<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_sky">
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#33000000" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="56dp" android:layout_marginEnd="56dp" android:layout_marginTop="80dp"
        android:layout_marginBottom="180dp" android:background="@drawable/glass_main_panel"
        android:orientation="horizontal" android:padding="56dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Details" android:textColor="#FFFFFF" android:textSize="24sp" android:fontFamily="sans-serif-medium"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" android:background="#40FFFFFF"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wind" android:textColor="#CCFFFFFF" android:textSize="18sp"/>
                <TextView android:id="@+id/detail_wind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- km/h" android:textColor="#FFFFFF" android:textSize="18sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Humidity" android:textColor="#CCFFFFFF" android:textSize="18sp"/>
                <TextView android:id="@+id/detail_humidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textColor="#FFFFFF" android:textSize="18sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:gravity="center_vertical|end" android:orientation="vertical">
            <TextView android:id="@+id/hero_condition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading..." android:textColor="#CCFFFFFF" android:textSize="20sp"/>
            <TextView android:id="@+id/hero_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="180sp" android:fontFamily="sans-serif-thin"/>
            <TextView android:id="@+id/hero_city" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="City" android:textColor="#FFFFFF" android:textSize="48sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/hero_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monday 18:30" android:textColor="#B3FFFFFF" android:textSize="18sp"/>
        </LinearLayout>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_marginBottom="48dp" android:paddingStart="56dp" android:paddingEnd="56dp" android:scrollbars="none" android:focusable="false">
        <LinearLayout android:id="@+id/daily_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
    </HorizontalScrollView>
</FrameLayout>
